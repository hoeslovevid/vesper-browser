# Browser branding
ac_add_options --with-app-name=${binName}
ac_add_options --with-app-basename=Vesper

# Localization (Must be an absolute path)
ac_add_options --with-l10n-base="${topsrcdir}/browser/locales"

export MOZ_APP_BASENAME=Vesper
export MOZ_BRANDING_DIRECTORY=${brandingDir}
export MOZ_OFFICIAL_BRANDING_DIRECTORY=${brandingDir}

# Keep Firefox's application ID so addons.mozilla.org extensions install.
export MOZ_APP_ID={ec8030f7-c20a-464f-9b0e-13a3a9e97384}

ac_add_options --with-distribution-id=app.vesper.browser

# Uncomment if builds are too resource hungry
# mk_add_options MOZ_MAKE_FLAGS="-j4"
# ac_add_options --enable-linker=gold

# Misc
export MOZ_SOURCE_REPO=https://github.com/vesper-browser/desktop
export MOZ_SOURCE_CHANGESET=${changeset}
export MOZ_INCLUDE_SOURCE_INFO=1

ac_add_options --enable-application=browser

# Spaceless junctions: C:\llvm -> C:\Program Files\LLVM, NASM at C:\nasm
# (configure splits on spaces; "Program Files" becomes "Files/LLVM/...")
# no-update: use already-downloaded toolchains; full bootstrap needs a complete engine git tree
ac_add_options --enable-bootstrap=no-update
export CC="C:/llvm/bin/clang-cl.exe"
export CXX="C:/llvm/bin/clang-cl.exe"
export HOST_CC="C:/llvm/bin/clang-cl.exe"
export HOST_CXX="C:/llvm/bin/clang-cl.exe"
export NASM="C:/nasm/nasm.exe"
export MOZ_WINDOWS_APP_SDK_DIR="C:/vesper/toolchains/winappsdk-x86_64-pc-windows-msvc"
ac_add_options --with-wasi-sysroot="C:/vesper/toolchains/sysroot-wasm32-wasi"
# Single-path compilers only: MSYS2 mangles `-resource-dir=C:/...` into `C;C:\...`
export WASM_CC="C:/vesper/toolchains/wasm-clang/bin/clang.exe"
export WASM_CXX="C:/vesper/toolchains/wasm-clang/bin/clang++.exe"
export MOZ_WINDOWS_RS_DIR="C:/vesper/toolchains/windows-rs"
export GMAKE="C:/vesper/toolchains/mozmake/mozmake.exe"

if test "$SCCACHE_GHA_ENABLED" = "true"; then
  if test -x "$(command -v sccache)"; then
    ac_add_options --with-ccache=sccache
  elif test -f "$HOME/.mozbuild/sccache/sccache"; then
    ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
  fi

  mk_add_options 'export RUSTC_WRAPPER=sccache'
  mk_add_options 'export CCACHE_CPP2=yes'
fi

# Optional API keys (do not commit these files)
if test -f "$HOME/.vesper-keys/safebrowsing.dat"; then
  ac_add_options --with-google-safebrowsing-api-keyfile="$HOME/.vesper-keys/safebrowsing.dat"
fi

if test -f "$HOME/.vesper-keys/mozilla.dat"; then
  ac_add_options --with-mozilla-api-keyfile="$HOME/.vesper-keys/mozilla.dat"
fi

if test -f "$HOME/.vesper-keys/google_location_service.dat"; then
  ac_add_options --with-google-location-service-api-keyfile="$HOME/.vesper-keys/google_location_service.dat"
fi

if test "$ZEN_RELEASE"; then

  ac_add_options --enable-clang-plugin
  ac_add_options --enable-bootstrap=-sccache

  ac_add_options --enable-optimize

  ac_add_options --enable-release
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-debug-js-modules
  ac_add_options --disable-tests

  ac_add_options --enable-rust-simd
  ac_add_options --enable-wasm-simd

  ac_add_options --disable-geckodriver
  ac_add_options --disable-rust-tests

  if ! test "$ZEN_DISABLE_LTO"; then
    # only enable full LTO when ZEN_RELEASE_BRANCH is 'release'
    if test "$ZEN_RELEASE_BRANCH" = "release"; then
      # TODO: make it "full" once we have the resources to build it
      export MOZ_LTO=cross,full
      ac_add_options --enable-lto=cross,full
    else
      export MOZ_LTO=cross,thin
      ac_add_options --enable-lto=cross,thin
    fi
  fi

  mk_add_options MOZILLA_OFFICIAL=1
  MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1

  mk_add_options AUTOCLOBBER=1
  export AUTOCLOBBER=1

  export MOZ_PACKAGE_JSSHELL=1

  ac_add_options --disable-crashreporter
fi

ac_add_options --enable-jxl

ac_add_options --with-unsigned-addon-scopes=app,system

mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
mk_add_options MOZ_TELEMETRY_REPORTING=

ac_add_options MOZ_DATA_REPORTING=
ac_add_options MOZ_TELEMETRY_REPORTING=

# Signed AMO add-ons still install. Compile-time signing is left unset so
# local/dev builds can load unsigned XPIs; the public default pref still
# requires signatures (prefs/firefox/extensions.yaml).
export MOZ_REQUIRE_SIGNING=
mk_add_options MOZ_REQUIRE_SIGNING=
